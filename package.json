{
  "name": "vivestream-revived",
  "version": "13.2.0",
  "description": "Your personal, offline, and stylish media sanctuary. Revived.",
  "main": "src/main/main.js",
  "author": "Md Siam Mia",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild",
    "vendor:init": "node helpers/vendor-init.js",
    "build": "node helpers/build-manager.js",
    "build:win": "node helpers/builder.js --win --target=nsis,msi,source",
    "build:linux": "node helpers/builder.js --linux --target=AppImage,deb,snap,tar.gz",
    "build:docker": "bash ./docker-build.sh --target=AppImage,deb,rpm,snap,tar.gz",
    "build:linux:ci": "node helpers/builder.js --linux --target=AppImage,deb,rpm,snap,flatpak,tar.gz",
    "build:all": "npm run build:win && npm run build:linux",
    "postinstall": "npm run rebuild && npm run vendor:init",
    "test": "jest"
  },
  "keywords": [],
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron/rebuild": "^4.0.2",
    "babel-jest": "^30.2.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.4.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.4.1",
    "rimraf": "^6.1.2"
  },
  "dependencies": {
    "fs-extra": "^11.3.3",
    "knex": "^3.1.0",
    "sortablejs": "^1.15.6",
    "sqlite3": "^5.1.7"
  },
  "jest": {
    "testEnvironment": "jsdom"
  },
  "build": {
    "appId": "com.vivestream.revived.app",
    "productName": "ViveStream Revived"
  }
}
